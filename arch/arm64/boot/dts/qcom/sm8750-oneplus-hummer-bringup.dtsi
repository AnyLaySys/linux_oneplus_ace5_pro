#include "sm8750-oneplus-hummer-regulators.dtsi"

&{/firmware} {
	status = "okay";
};

&{/firmware/scmi} {
	status = "disabled";
};

&{/clocks} {
	status = "okay";
};

&vph_pwr {
	status = "okay";
};

&{/reserved-memory/aop_cmd_db_region@81c60000} {
	compatible = "qcom,cmd-db";
};

&apps_rsc {
	/delete-property/ power-domains;
	status = "okay";
};

&gcc {
	status = "okay";
};

&tcsrcc {
	status = "okay";
};

&mc_virt {
	status = "okay";
};

&config_noc {
	status = "okay";
};

&cnoc_main {
	status = "okay";
};

&system_noc {
	status = "okay";
};

&aggre1_noc {
	status = "okay";
};

&aggre2_noc {
	status = "okay";
};

&gem_noc {
	status = "okay";
};

&tlmm {
	/delete-property/ wakeup-parent;
	status = "okay";
};

&apps_smmu {
	status = "okay";
};

&vreg_l1j_0p91 {
	regulator-min-microvolt = <912000>;
};

&ufs_mem_hc {
	/delete-property/ qcom,ice;
};

&rpmhpd {
	oneplus,keep-unclaimed-rpmh-votes;
};

&scm {
	status = "disabled";
};

&{/reserved-memory/mu_dxe_heap@bd930000} {
	/delete-property/ no-map;
};

&{/reserved-memory/mu_dxe_heap_tail@d5100000} {
	/delete-property/ no-map;
};

&scm {
	status = "okay";
};

&tlmm {
	gpio-reserved-ranges = <0 16>, <17 31>, <52 50>, <105 56>, <163 52>;

	touch_reset_default: touch-reset-default-state {
		pins = "gpio161";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	touch_irq_default: touch-irq-default-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		input-enable;
	};
};

&ufs_mem_phy {
	status = "okay";
};

&ufs_mem_hc {
	status = "okay";
};

&aoss_qmp {
	status = "okay";
};

&ipcc {
	status = "okay";
};

&clk_virt {
	status = "okay";
};

&gpi_dma1 {
	dma-coherent;
	status = "okay";
};

&qupv3_1 {
	status = "okay";
};

&vreg_l4b_1p8 {
	status = "okay";
};

&vreg_l16b_2p8 {
	regulator-min-microvolt = <3104000>;
	regulator-max-microvolt = <3104000>;
	status = "okay";
};

&spi4 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,s3910";
		reg = <0>;
		spi-max-frequency = <19000000>;
		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
		vddio-supply = <&vreg_l4b_1p8>;
		avdd-supply = <&vreg_l16b_2p8>;
		pinctrl-0 = <&touch_reset_default &touch_irq_default>;
		pinctrl-names = "default";
	};
};

&{/} {
	wcn786x-pmu {
		compatible = "qcom,wcn7861-pmu";
		qcom,qmp = <&aoss_qmp>;
		qcom,pdc-init-table =
			"{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}";
		qcom,vreg-pdc-map = "s5f:rf", "s4d:bb", "s3g:rf", "s7i:rf";
		qcom,pmu-vreg-map =
			"VDDD_AON_0P9:s5f", "VDDA_RFA_1P9:s3g",
			"VDDA_RFA_1P3:s7i", "VDDA_RFA_0P9:s5f",
			"VDDD_WLMX_0P9:s4d", "VDDD_WLCX_0P9:s5f",
			"VDDD_BTCX_0P9:s5f", "VDDD_BTCMX_0P85:s5f",
			"VDDA_PCIE_1P2:s7i", "VDDA_PCIE_0P9:s7i";
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_default>;
		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		clocks = <&rpmhcc RPMH_RF_CLK1>;
		vdd-supply = <&vreg_s5f_0p85>;
		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s4d_0p85>;
		vdddig-supply = <&vreg_s5f_0p85>;
		vddrfa1p2-supply = <&vreg_s7i_1p2>;
		vddrfa1p8-supply = <&vreg_s3g_1p8>;

	};
};

&tlmm {
	wlan_en_default: wlan-en-default-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&{/soc@0/rsc@16500000/regulators-2} {
	status = "okay";
};

&vreg_s4d_0p85 {
	regulator-min-microvolt = <876000>;
	status = "okay";
};

&vreg_s5f_0p85 {
	regulator-min-microvolt = <876000>;
};

&vreg_s3g_1p8 {
	regulator-min-microvolt = <1864000>;
	regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
	status = "okay";
};

&vreg_s7i_1p2 {
	regulator-min-microvolt = <1312000>;
};

&vreg_l8b_1p8 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	status = "okay";
};

&pcie_noc {
	status = "okay";
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_default_state>;
	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;
	status = "okay";
};

&pcieport0 {
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;

	wifi@0 {
		compatible = "pci17cb,110e";
		reg = <0x10000 0 0 0 0>;
		vddaon-supply = <&vreg_s4d_0p85>;
	};
};

&{/soc@0/remoteproc@6800000/glink-edge} {
	pmic_glink_rpmsg {
		qcom,glink-channels = "PMIC_RTR_ADSP_APPS";
	};
};

&{/smp2p-adsp} {
	status = "okay";
};

&{/soc@0/hwlock@1f40000} {
	status = "okay";
};

&lpass_ag_noc {
	status = "okay";
};

&lpass_lpiaon_noc {
	status = "okay";
};

&lpass_lpicx_noc {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "adsp.mdt", "adsp_dtb.mdt";
	status = "okay";
};

&usb_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&{/} {
	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};
			};
		};
	};
};
