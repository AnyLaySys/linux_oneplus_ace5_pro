};

&remoteproc_adsp {
	firmware-name = "adsp.mdt", "adsp_dtb.mdt";
	status = "okay";
};

&usb_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&{/} {
	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};
			};
		};
	};
};

#include "oplus_chg/oplus-chg-24811.dtsi"

&{/} {
	wcd939x: audio-codec {
		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";
		pinctrl-names = "default";
		pinctrl-0 = <&wcd939x_reset_active>;
		qcom,micbias1-microvolt = <2700000>;
		qcom,micbias2-microvolt = <2700000>;
		qcom,micbias3-microvolt = <2700000>;
		qcom,micbias4-microvolt = <2700000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;
		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;
		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;
		vdd-px-supply = <&vreg_l2i_1p2>;
		#sound-dai-cells = <1>;
	};

	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		model = "OnePlus Ace 5 Pro";
		clocks = <&q6prmcc LPASS_CLK_ID_SEC_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "mi2s";
		pinctrl-names = "default";
		pinctrl-0 = <&mi2s1_sck_active &mi2s1_ws_active &mi2s1_sd0_active &mi2s1_sd1_active>;
		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC2", "MIC BIAS2",
				"AMIC1", "MIC BIAS1",
				"AMIC3", "MIC BIAS4",
				"AMIC5", "MIC BIAS1",
				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT1", "ADC2_OUTPUT",
				"TX SWR_INPUT3", "ADC4_OUTPUT";

		wcd-playback-dai-link {
			link-name = "WCD Playback";
			codec { sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>; };
			cpu { sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>; };
			platform { sound-dai = <&q6apm>; };
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";
			codec { sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>; };
			cpu { sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>; };
			platform { sound-dai = <&q6apm>; };
		};

		speaker-dai-link {
			link-name = "Secondary MI2S Playback";
			codec { sound-dai = <&sipa_i2c_L>, <&sipa_i2c_R>; };
			cpu { sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>; };
			platform { sound-dai = <&q6apm>; };
		};
	};
};

&swr1 {
	wcd_rx: codec@0,4 {
		compatible = "sdw20217010e00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5 9>;
	};
};

&swr2 {
	wcd_tx: codec@0,3 {
		compatible = "sdw20217010e00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};
