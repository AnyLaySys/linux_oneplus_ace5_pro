	status = "okay";
};

&i2c3 {
	status = "okay";

	wcd939x_i2c@e {
		compatible = "qcom,wcd939x-i2c";
		reg = <0xe>;
		vdd-supply = <&vreg_l15b_1p8>;
	};
};

&vreg_l4b_1p8 {
	status = "okay";
};

&vreg_l2d_0p88 {
	status = "okay";
};

&vreg_l5b_3p1 {
	status = "okay";
};

&vreg_l15b_1p8 {
	status = "okay";
};

&vreg_l16b_2p8 {
	regulator-min-microvolt = <3104000>;
	regulator-max-microvolt = <3104000>;
	status = "okay";
};

&spi4 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,s3910";
		reg = <0>;
		spi-max-frequency = <19000000>;
		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
		vddio-supply = <&vreg_l4b_1p8>;
		avdd-supply = <&vreg_l16b_2p8>;
		pinctrl-0 = <&touch_reset_default &touch_irq_default>;
		pinctrl-names = "default";
	};
};

&{/} {
	wcn786x-pmu {
		compatible = "qcom,wcn7861-pmu";
		qcom,qmp = <&aoss_qmp>;
		qcom,pdc-init-table =
			"{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}";
		qcom,vreg-pdc-map = "s5f:rf", "s4d:bb", "s3g:rf", "s7i:rf";
		qcom,pmu-vreg-map =
			"VDDD_AON_0P9:s5f", "VDDA_RFA_1P9:s3g",
			"VDDA_RFA_1P3:s7i", "VDDA_RFA_0P9:s5f",
			"VDDD_WLMX_0P9:s4d", "VDDD_WLCX_0P9:s5f",
			"VDDD_BTCX_0P9:s5f", "VDDD_BTCMX_0P9:s5f",
			"VDDA_PCIE_1P2:s7i", "VDDA_PCIE_0P9:s7i";
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_default &bt_en_default>;
		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
		clocks = <&rpmhcc RPMH_RF_CLK1>;
		vdd-supply = <&vreg_s5f_0p85>;
		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s4d_0p85>;
		vdddig-supply = <&vreg_s5f_0p85>;
		vddrfa1p2-supply = <&vreg_s7i_1p2>;
		vddrfa1p8-supply = <&vreg_s3g_1p8>;

	};
};

&tlmm {
	wlan_en_default: wlan-en-default-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&pm8550ve_f_gpios {
	bt_en_default: bt-en-default-state {
		pins = "gpio3";
		function = "normal";
		output-enable;
		bias-disable;
		power-source = <1>;
	};
};

&{/} {
	aliases {
		serial0 = &uart14;
	};
};

&qupv3_2 {
	status = "okay";
};

&i2c_master_hub_0 {
	status = "okay";
};

&i2c_hub_1 {
	status = "okay";
};

&i2c_hub_4 {
	status = "okay";
	qcom,clk-freq-out = <400000>;

	sipa_i2c_L: sipa91xx_i2c@6c {
		compatible = "si,sia91xx-i2c";
		reg = <0x6c>;
		#sound-dai-cells = <0>;
		si,sipa-dev = <&sia91xx_L>;
		sound-name-prefix = "SpkrLeft";
	};

	sipa_i2c_R: sipa91xx_i2c@6d {
		compatible = "si,sia91xx-i2c";
		reg = <0x6d>;
		#sound-dai-cells = <0>;
		si,sipa-dev = <&sia91xx_R>;
		sound-name-prefix = "SpkrRight";
	};
};

&soc {
	battery_charger: battery-charger {};
};

&soc {
	sia91xx_L: sia91xx@L {
		compatible = "si,sia91xx";
		si,si_pa_type = "sia9177";
		si,si_pa_disable_pin = <0>;
		si,si_pa_reset = <&tlmm 2 0>;
		pinctrl-names = "si_pa_gpio";
		pinctrl-0 = <&sia91xx_gpio_L>;
		channel_num = <0>;
		sipa_min_range = <5300>;
		sipa_max_range = <7500>;
		sipa_default_mohm = <6000>;
		sipa_min_freq = <100>;
		sipa_max_freq = <2000>;
		is_use_freq = <1>;
	};

	sia91xx_R: sia91xx@R {
		compatible = "si,sia91xx";
		si,si_pa_type = "sia9177";
		si,si_pa_disable_pin = <0>;
		si,si_pa_reset = <&tlmm 164 0>;
		pinctrl-names = "si_pa_gpio";
		pinctrl-0 = <&sia91xx_gpio_R>;
		channel_num = <1>;
		sipa_min_range = <5300>;
		sipa_max_range = <7500>;
		sipa_default_mohm = <6000>;
		sipa_min_freq = <100>;
		sipa_max_freq = <2000>;
		is_use_freq = <1>;
	};
};

&uart14 {
	pinctrl-0 = <&qup_uart14_default &qup_uart14_cts_rts>;
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7850-bt";
		max-speed = <8000000>;
