&tlmm {
	gpio-reserved-ranges = <0 2>, <3 13>, <17 7>, <28 16>, <46 2>, <52 14>, <68 4>, <74 12>, <87 11>, <99 2>, <105 16>, <125 36>, <165 41>, <208 7>;

	mi2s1_sck_active: mi2s1-sck-active-state {
		pins = "gpio121";
		function = "i2s1_sck";
		drive-strength = <8>;
		bias-disable;
	};

	mi2s1_ws_active: mi2s1-ws-active-state {
		pins = "gpio123";
		function = "i2s1_ws";
		drive-strength = <8>;
		bias-disable;
	};

	mi2s1_sd0_active: mi2s1-sd0-active-state {
		pins = "gpio122";
		function = "i2s1_data0";
		drive-strength = <8>;
		bias-disable;
	};

	mi2s1_sd1_active: mi2s1-sd1-active-state {
		pins = "gpio124";
		function = "i2s1_data1";
		drive-strength = <8>;
		bias-disable;
	};

	wcd939x_reset_active: wcd939x-reset-active-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-high;
	};

	sia91xx_gpio_L: sia91xx-gpio-left-state {
		pins = "gpio2";
		function = "gpio";
		drive-strength = <6>;
		bias-disable;
	};

	sia91xx_gpio_R: sia91xx-gpio-right-state {
		pins = "gpio164";
		function = "gpio";
		drive-strength = <6>;
		bias-disable;
	};

	touch_reset_default: touch-reset-default-state {
		pins = "gpio161";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	touch_irq_default: touch-irq-default-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		input-enable;
	};
};

&ufs_mem_phy {
	status = "okay";
};

&ufs_mem_hc {
	status = "okay";
